// Translated from janus-examples watanabe/J1/Fibonacci program.j1 (Yokoyama & Gluck PEPM 2007, p.145)
// Changes: implicit globals declared as `int n int x1 int x2`; `main_fwd` -> `main`
// (`main_bwd` is j1-fib-bwd.janus).  The recursive `call fib` is kept.
int n
int x1
int x2
procedure fib
  if n = 0 then
    x1 += 1
    x2 += 1
  else
    n -= 1
    call fib
    x1 += x2
    x1 <=> x2
  fi x1 = x2
procedure main
  n += 4
  call fib
