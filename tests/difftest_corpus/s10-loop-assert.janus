// Own stress test (INVALID Janus on purpose): the loop's re-entry assertion
// `y = 0` must be false when the body is re-entered, but y never changes.
// PyJanus reports the violated assertion; pyjanus2pisa's codegen clears the
// flag with `XOR rt rt` instead of checking it, so pisa_interp runs to x = 3
// and the round trip fails (the inverse loop exits immediately).  Under
// Pendulum semantics (phpisa, pendulum-cf lowering) the violated assertion
// leaves the branch register non-zero and execution runs off the program.
int y
int x
procedure main
  from y = 0 do
    x += 1
  loop
    skip
  until x = 3
