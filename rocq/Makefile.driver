# Build the extracted verified compiler into a driver binary.
#   make -f Makefile.driver        # build .vo, extract (Extract.v), compile driver
#   ./driver                       # emit the reference data
#
# Extraction writes one module per Rocq library it needs (BinNums, BinInt,
# List, ..., PISA, Src, Compile), and which ones depends on the proofs, so the
# link order is computed by `ocamldep -sort` over every .ml/.mli here instead
# of being written out: a hand-written `PISA.ml Src.ml Compile.ml driver.ml`
# stopped linking once the extracted code started to `open BinInt`.

driver: .extracted driver.ml
	ocamlfind ocamlopt -package str -linkpkg \
	  $$(ocamlfind ocamldep -sort *.mli *.ml) -o driver

.extracted: Extract.v PISA.vo Src.vo Compile.vo
	rocq compile -Q . "" Extract.v
	touch $@

# The .vo files come from the rocq-makefile build of _CoqProject.
Makefile: _CoqProject
	rocq makefile -f _CoqProject -o Makefile

%.vo: %.v Makefile
	$(MAKE) -f Makefile $@

clean-driver:
	rm -f driver *.cm* *.o .extracted

.PHONY: clean-driver
